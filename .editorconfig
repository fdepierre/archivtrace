# Portable editor defaults for ArchivTrace (VS Code, Cursor, Windsurf, JetBrains, …).
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[*.{md,mdc}]
trim_trailing_whitespace = false

[*.{xml.txt,xml}]
indent_size = 2

[Makefile]
indent_style = tab
